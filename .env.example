# Optional OpenSky OAuth2 client credentials.
# Leave unset for anonymous access (lower rate limits) or for mock traffic.
# Never commit real values. See docs/data-sources.md.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# Optional adsb.lol API key. Raises the daily request limit for the backup feed.
# Leave unset for keyless access (500 requests a day per IP).
# ADSBLOL_API_KEY=
